{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "description": "Boot a minimal x86_64 kernel in QEMU and require the serial marker.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "genesis": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/src/cli.js build",
    "start": "tsc -p tsconfig.json && node dist/src/cli.js run",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 --test-timeout 120000 dist/test/*.test.js",
    "panel": "npm --prefix panel run dev",
    "look": "tsc -p tsconfig.json && node dist/src/cli.js show"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
